# --- secrets -------------------------------------------------------------
# note.txt holds the BFL API key in plain text. The file is kept on disk on
# purpose (dev convenience) but must never enter the history.
note.txt
dressly/note.txt
.env
*.env

# --- user data (555 MB of photos + the SQLite DB) ------------------------
backend/data/
pictures/

# --- python --------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# --- flutter / dart ------------------------------------------------------
dressly/build/
dressly/.dart_tool/
dressly/.flutter-plugins
dressly/.flutter-plugins-dependencies
dressly/android/local.properties
dressly/ios/Flutter/Generated.xcconfig
dressly/ios/Flutter/flutter_export_environment.sh
dressly/.idea/
dressly/*.iml
dressly/android/*.iml

# --- os / editor ---------------------------------------------------------
.DS_Store
*.swp

# --- backups + audit artefacts (hundreds of MB / regenerated on demand) ----
clothes-app-backup-*/
*-backup-*/
mutation_report.json
never_killed.json

# --- TLS material --------------------------------------------------------
# Private keys must never be committed. Regenerate with make_cert.py.
backend/certs/
*.key
*.pem
# Cloudflare's dashboard hands the Origin CA pair out as .txt, which none of
# the patterns above catch — and it lands in whatever directory you saved it to.
Origin-Certificate.txt
Private-Key.txt
*-Certificate.txt
*Private-Key*.txt

# Deployment archive produced by scripts/export_for_server.sh (~430 MB).
dressly-backend.tar*

# --- notes personnelles et sauvegardes locales (hors dépôt) ---------------
backup-do-not-read/
do-not-read.txt
usefull-commands.txt
install.log
backend/certs/
