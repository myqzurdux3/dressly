# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- required in production ------------------------------------------------
CLOTHESAPP_ENV=prod

# Signs every login token. Think of it as the server's master password: anyone
# who knows it can mint a token for any account, including an admin one.
# It is NOT something you invent — any random string of 32+ bytes works. It just
# has to stay secret and stay the same (changing it signs everyone out).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOTHESAPP_SECRET=

# NOT a secret — do not put a random string here. This is the list of websites
# allowed to call the API from a browser. It is a browser-only rule, so the
# phone app ignores it entirely; if you never run the app in a browser, any
# placeholder value does the job. "*" (meaning "any website") is refused in
# production, which is why something has to be set.
CLOTHESAPP_CORS=https://app.invalid

# --- network ---------------------------------------------------------------
# 0.0.0.0 accepts connections from anywhere, which is what a VPS needs.
# run-prod.sh serves HTTPS itself when backend/certs/ holds a certificate:
#   python scripts/make_cert.py --host <your-public-ip>
# Without one it falls back to plain HTTP and says so loudly.
CLOTHESAPP_HOST=0.0.0.0
CLOTHESAPP_PORT=8000
# Rate limits and job ownership live in SQLite, so several workers stay
# consistent. Each worker holds its own rembg model (~200 MB) — size to RAM.
CLOTHESAPP_WORKERS=3
# Only relevant behind a reverse proxy: whose X-Forwarded-For to believe.
CLOTHESAPP_TRUSTED_PROXIES=127.0.0.1

# --- image URL signing -----------------------------------------------------
# On by default outside dev. Without it, /images/3/front_0.jpg is guessable and
# anyone who can reach the port can enumerate the wardrobe.
# CLOTHESAPP_SIGN_IMAGE_URLS=1
# How long a signed image URL stays valid (seconds). Default one week.
# CLOTHESAPP_IMAGE_URL_TTL_S=604800

# --- optional --------------------------------------------------------------
# Where the DB and images live. Defaults to backend/data.
# CLOTHESAPP_DATA_DIR=/var/lib/dressly

# Image generation. With no key the server returns placeholder images.
BFL_API_KEY=

# Per-user spend guards (0 disables). Both bill bfl.ai per call.
# CLOTHESAPP_GEN_RATE_LIMIT=30
# CLOTHESAPP_ENHANCE_RATE_LIMIT=40

# Sign-in protection, per IP. The second is a tighter budget on FAILED attempts.
# CLOTHESAPP_AUTH_RATE_LIMIT=30
# CLOTHESAPP_AUTH_FAIL_LIMIT=10

# Threads onnxruntime may use for background removal. Setting it at all is what
# stops the "pthread_setaffinity_np failed ... error code: 22" messages on a VPS
# whose cgroup forbids pinning threads to cores. Defaults to all cores but one.
# CLOTHESAPP_REMBG_THREADS=4

# Emails allowed to read the manager-only report queues.
# DRESSLY_ADMIN_EMAILS=you@example.com
