# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- required in production ------------------------------------------------
CLOTHESAPP_ENV=prod

# Signs every login token. Think of it as the server's master password: anyone
# who knows it can mint a token for any account, including an admin one.
# It is NOT something you invent — any random string of 32+ bytes works. It just
# has to stay secret and stay the same (changing it signs everyone out).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOTHESAPP_SECRET=

# NOT a secret — do not put a random string here. This is the list of websites
# allowed to call the API from a browser. It is a browser-only rule, so the
# phone app ignores it entirely; if you never run the app in a browser, any
# placeholder value does the job. "*" (meaning "any website") is refused in
# production, which is why something has to be set.
CLOTHESAPP_CORS=https://app.invalid

# --- network ---------------------------------------------------------------
# 0.0.0.0 accepts connections from anywhere, which is what a VPS needs.
# run-prod.sh serves HTTPS itself when backend/certs/ holds a certificate:
#   python scripts/make_cert.py --host <your-public-ip>
# Without one it falls back to plain HTTP and says so loudly.
CLOTHESAPP_HOST=0.0.0.0
CLOTHESAPP_PORT=80
# Rate limits and job ownership live in SQLite, so several workers stay
# consistent. Each worker is ~40 MB: background removal runs in a separate
# short-lived process, so no worker holds an ONNX model for the rest of its life.
CLOTHESAPP_WORKERS=3
# Only relevant behind a reverse proxy: whose X-Forwarded-For to believe.
CLOTHESAPP_TRUSTED_PROXIES=127.0.0.1

# --- image URL signing -----------------------------------------------------
# On by default outside dev. Without it, /images/3/front_0.jpg is guessable and
# anyone who can reach the port can enumerate the wardrobe.
# CLOTHESAPP_SIGN_IMAGE_URLS=1
# How long a signed image URL stays valid (seconds). Default one week.
# CLOTHESAPP_IMAGE_URL_TTL_S=604800

# --- optional --------------------------------------------------------------
# Where the DB and images live. Defaults to backend/data.
# CLOTHESAPP_DATA_DIR=/var/lib/dressly

# Image generation. With no key the server returns placeholder images.
BFL_API_KEY=

# Per-user spend guards (0 disables). Both bill bfl.ai per call.
# CLOTHESAPP_GEN_RATE_LIMIT=600
# CLOTHESAPP_ENHANCE_RATE_LIMIT=600

# Sign-in protection, per IP. The second is a tighter budget on FAILED attempts.
# CLOTHESAPP_AUTH_RATE_LIMIT=30
# CLOTHESAPP_AUTH_FAIL_LIMIT=10

# Threads onnxruntime may use for background removal. Setting it at all is what
# stops the "pthread_setaffinity_np failed ... error code: 22" messages on a VPS
# whose cgroup forbids pinning threads to cores. Defaults to the cores available
# divided by CLOTHESAPP_WORKERS, because each worker can spawn a cut-out of its
# own — three workers each taking every core turned a 2 s cut-out into 30 s of
# thrashing. Lower it if run-prod.sh's "Threads: N per worker" looks generous.
# CLOTHESAPP_REMBG_THREADS=4

# How many cut-outs may run at once per worker. A memory limit, not a CPU one:
# each one peaks near 830 MB, so raising this is how you get the kernel to kill
# a worker ("Child process [...] died"). 1 means the two photos of a garment are
# processed one after the other — about 2 s each.
# CLOTHESAPP_CUTOUT_CONCURRENCY=1
# Give up on a cut-out after this long, so an upload cannot hang forever.
# CLOTHESAPP_CUTOUT_TIMEOUT_S=120

# Emails allowed to read the manager-only queues and the API credits screen.
# A user with is_admin=1 in the database qualifies without being listed here.
# DRESSLY_ADMIN_EMAILS=you@example.com

# --- image API: models, budgets, cost --------------------------------------
# Which endpoint each quality tier maps to. The caps on how many reference
# images may be sent follow the slug automatically (klein takes 4, pro/max/flex
# take 8), so re-pointing a tier here moves its cap with it.
# BFL_MODEL_FLEX=flux-2-klein-4b
# BFL_MODEL_PRO=flux-2-pro
# BFL_MODEL_MAX=flux-2-max
# Virtual try-on. v2 has the same request shape as v1 and renders up to 4 MP.
# BFL_MODEL_VTO=flux-tools/vto-v2

# How tolerant the provider's moderation is, 0 (strictest) to 5. Their default
# is 2. Raise it if ordinary photos of garments keep coming back refused — the
# app now says "the provider declined this image" when that happens, instead of
# reporting a timeout.
# BFL_SAFETY_TOLERANCE=2

# How long an image enhancement may take before it is called failed. These must
# stay ordered: one attempt (BFL_UPLOAD_TIMEOUT_S + BFL_POLL_TIMEOUT_S, 120 s by
# default) < the sweep, and the deadline below one attempt so it can actually
# stop the cascade starting another tier.
# CLOTHESAPP_ENHANCE_DEADLINE_S=90
# CLOTHESAPP_ENHANCE_TIMEOUT_S=180

# Where the admin screen reads the account balance. Defaults to the documented
# GET /v1/credits under BFL_BASE_URL; set it only if that moves.
# BFL_BALANCE_URL=
# Their published rate, used to show the balance and the spend in dollars.
# BFL_USD_PER_CREDIT=0.01

# --- admin alerts (optional) -----------------------------------------------
# User-reported problems are always stored; these push them out-of-band so an
# admin sees them without looking. With nothing set they go to the log only.
# DRESSLY_ADMIN_WEBHOOK=https://hooks.slack.com/services/...
# DRESSLY_ADMIN_EMAIL=you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=1

# --- thumbnails ------------------------------------------------------------
# Encoder effort for the grid thumbnails. Above 4 costs an order of magnitude
# more time for a few percent of size, while somebody stares at an empty grid.
# CLOTHESAPP_THUMB_METHOD=4
# CLOTHESAPP_THUMB_QUALITY=90
