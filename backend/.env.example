# Copy to .env and fill in. .env is gitignored — never commit real values.
#
#   cp .env.example .env

# --- required in production ------------------------------------------------
CLOTHESAPP_ENV=prod

# Signs every JWT. Anyone who knows it can mint an admin token for any account.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLOTHESAPP_SECRET=

# Explicit list of origins allowed to call the API from a browser. The Flutter
# mobile app does not need this (CORS is a browser rule), but leaving it as "*"
# is refused in prod. Use the site's own origin, e.g. https://app.example.com
CLOTHESAPP_CORS=https://example.invalid

# --- network ---------------------------------------------------------------
# Bind to localhost and put a TLS-terminating reverse proxy (Caddy, nginx) in
# front. Binding 0.0.0.0 directly exposes plain HTTP: every login, every JWT and
# every photo would travel in clear.
CLOTHESAPP_HOST=127.0.0.1
CLOTHESAPP_PORT=8000
# Whose X-Forwarded-For to believe. Keep this to the proxy's address only.
CLOTHESAPP_TRUSTED_PROXIES=127.0.0.1

# --- optional --------------------------------------------------------------
# Where the DB and images live. Defaults to backend/data.
# CLOTHESAPP_DATA_DIR=/var/lib/dressly

# Image generation. With no key the server returns placeholder images.
BFL_API_KEY=

# Per-user spend guards (0 disables). Both bill bfl.ai per call.
# CLOTHESAPP_GEN_RATE_LIMIT=30
# CLOTHESAPP_ENHANCE_RATE_LIMIT=40

# Emails allowed to read the manager-only report queues.
# DRESSLY_ADMIN_EMAILS=you@example.com
